[Unit]
Description=SubFluxGPT Training Scheduler
After=network.target postgresql.service redis.service
Requires=postgresql.service redis.service

[Service]
Type=simple
User=beanman
WorkingDirectory=/Users/beanman/Documents/Desktop/SubFluxGPT
Environment="PATH=/Users/beanman/Documents/Desktop/SubFluxGPT/venv/bin"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/Users/beanman/Documents/Desktop/SubFluxGPT/venv/bin/python -m training_pipeline.scheduler
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
