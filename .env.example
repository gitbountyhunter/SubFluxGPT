# SubFluxGPT Configuration
# Copy this file to .env and fill in your API keys

# Primary AI API (recommended: Gemini for free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback AI APIs (optional)
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Netlas API (free for developers - sign up at https://netlas.io)
NETLAS_API_KEY=your_netlas_api_key_here

# BBRF Configuration (optional - for bug bounty workflows)
BBRF_SERVER=http://localhost:8080
BBRF_USERNAME=your_bbrf_username
BBRF_PASSWORD=your_bbrf_password
